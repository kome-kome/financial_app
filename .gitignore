# 仮想環境
venv/
.venv/

# Python キャッシュ
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb

# ログ・一時ファイル
*.log
*.tmp

# 検証スクリプトのローカルキャッシュ（scripts/_cache.py 生成・本番 Egress 削減用・共有不要）
scripts/.cache/

# Egress 台帳（db_egress.py が FINAPP_EGRESS_LEDGER 指定時に append・実行環境ごとの記録）
.egress/

# 週次株価の run 間キャッシュ（weekly_price_cache.py 生成・#480）。GHA では actions/cache が
# 持ち回るのでリポジトリには入れない。消しても次回フルロードで作り直されるだけ。
.weekly_cache/

# DB 移行用ダンプ（pg_dump 生成物・サイズ大）
migration_dumps/
# stock_price dual-table 移行のローカル退避（migrate_stock_price_dual.py 生成・サイズ大）
stock_price_history_dump.csv.gz

# 秘密情報
.env
*.db
*.sqlite3

# IDE
.vscode/
.idea/
*.code-workspace
# Obsidian のワークスペース設定（このディレクトリを vault として開くと生成される・共有不要）
.obsidian/

# OS
.DS_Store
Thumbs.db

# ビルド成果物
dist/
build/
*.egg-info/

# Claude Code ローカル設定（共有不要）
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# デプロイ用ローカル設定
.env.local
.env.production

# ローカル夜間バッチのログ（#503・scripts/run_nightly.py が日次ローテートで書く）
.logs/
