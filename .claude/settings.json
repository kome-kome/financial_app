{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./.claude/hooks/stop-git-reminder.ps1\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "PowerShell(git status*)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git checkout *)",
      "PowerShell(git branch *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(gh pr create*)",
      "PowerShell(gh pr list*)",
      "PowerShell(gh pr view*)"
    ]
  }
}
