{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"./.claude/hooks/stop-git-reminder.ps1\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "PowerShell(git status*)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git checkout *)",
      "PowerShell(git branch *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(gh pr create*)",
      "PowerShell(gh pr list*)",
      "PowerShell(gh pr view*)"
    ],
    "deny": [
      "Bash(gh issue delete*)",
      "Bash(gh issue transfer*)",
      "Bash(gh run delete*)",
      "Bash(gh release delete*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo edit*)",
      "Bash(gh secret set*)",
      "Bash(gh secret delete*)",
      "Bash(gh secret remove*)",
      "Bash(gh variable set*)",
      "Bash(gh variable delete*)",
      "Bash(gh label delete*)",
      "Bash(gh cache delete*)",
      "Bash(gh ssh-key*)",
      "Bash(gh auth token*)",
      "PowerShell(gh issue delete*)",
      "PowerShell(gh issue transfer*)",
      "PowerShell(gh run delete*)",
      "PowerShell(gh release delete*)",
      "PowerShell(gh repo delete*)",
      "PowerShell(gh repo archive*)",
      "PowerShell(gh repo rename*)",
      "PowerShell(gh repo edit*)",
      "PowerShell(gh secret set*)",
      "PowerShell(gh secret delete*)",
      "PowerShell(gh secret remove*)",
      "PowerShell(gh variable set*)",
      "PowerShell(gh variable delete*)",
      "PowerShell(gh label delete*)",
      "PowerShell(gh cache delete*)",
      "PowerShell(gh ssh-key*)",
      "PowerShell(gh auth token*)"
    ]
  }
}
